{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "14": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "krea2_identity_edit_v1_2.safetensors", "strength_model": 1.0}},
  "4": {"class_type": "LoadImage", "inputs": {"image": "{{reference_image}}"}},
  "5": {"class_type": "ImageScaleToTotalPixels", "inputs": {"image": ["4", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 32}},
  "6": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "10": {"class_type": "VAEEncode", "inputs": {"pixels": ["5", 0], "vae": ["3", 0]}},
  "11": {"class_type": "Krea2EditModelPatch", "inputs": {"model": ["14", 0], "source_latent": ["10", 0], "vae": ["3", 0], "source_image": ["5", 0], "target_latent": ["6", 0], "ref_boost": 1.0, "ref_boost_a": 1.0, "fit_mode": "fit"}},
  "12": {"class_type": "Krea2EditGroundedEncode", "inputs": {"clip": ["2", 0], "prompt": "{{prompt}}", "image": ["5", 0], "grounding_px": 768, "system_prompt": ""}},
  "13": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["12", 0]}},
  "7": {"class_type": "KSampler", "inputs": {"model": ["11", 0], "positive": ["12", 0], "negative": ["13", 0], "latent_image": ["6", 0], "seed": "{{seed}}", "steps": 8, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["3", 0]}},
  "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "prospero-dungeon"}}
}
